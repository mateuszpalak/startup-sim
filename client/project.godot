; Engine configuration file.

config_version=5

[application]

config/name="Startup Sim"
config/version="0.3.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icons/icon.svg"
config/macos_native_icon="res://icons/icon.icns"
config/windows_native_icon="res://icons/icon.ico"
run/max_fps=60
boot_splash/bg_color=Color(0.12156863, 0.101960786, 0.18039216, 1)
boot_splash/image="res://icons/splash.png"
boot_splash/stretch_mode=1
boot_splash/show_image=true

[audio]

driver/enable_input=true
general/ios/session_category=2
general/ios/mix_with_others=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/ios/hide_home_indicator=true
window/ios/hide_status_bar=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.ios_simulator="gl_compatibility"

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=0

textures/vram_compression/import_etc2_astc=true

textures/canvas_textures/default_texture_filter=1

[shader_globals]

atmos_mask={
"type": "sampler2D",
"value": ""
}
atmos_mask_size={
"type": "vec2",
"value": Vector2(1, 1)
}
atmos_floor_y={
"type": "float",
"value": 0.0
}
atmos_wet={
"type": "float",
"value": 0.0
}
atmos_night={
"type": "float",
"value": 0.0
}
atmos_clouds={
"type": "float",
"value": 0.0
}
